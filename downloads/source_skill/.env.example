# AR LABS - Stream Clips Skill Environment Configuration
# Add either Gemini or Anthropic API key to enable AI highlight scoring

# Google Gemini API Key (Recommended for speed & cost)
GEMINI_API_KEY=your_gemini_api_key_here

# Anthropic Claude API Key (Alternative)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Default AI Model (gemini-2.5-flash or claude-3-5-sonnet-20241022)
DEFAULT_AI_MODEL=gemini-2.5-flash

# Default Output Directory for rendered clips
OUTPUT_DIR=./exported_clips

# Hardware Acceleration: 'auto', 'cuda' (NVIDIA GPU), 'qsv' (Intel), or 'cpu'
ACCELERATION=auto
